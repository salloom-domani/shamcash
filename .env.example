# Copy to .env (git-ignored) and fill in the sandbox credentials from ShamCash support.
SHAMCASH_AGENT_KEY=
SHAMCASH_SECRET_KEY=
SHAMCASH_BASE_URL=

# Optional: public URL that tunnels to the local webhook server in `bun run sandbox:pay`
# (e.g. `cloudflared tunnel --url http://localhost:3000`). Path: /webhooks/shamcash
SHAMCASH_PUBLIC_URL=
